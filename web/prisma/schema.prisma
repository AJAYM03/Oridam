generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  GoogleAccount[]
}

model GoogleAccount {
  id           String   @id @default(cuid())
  userId       String
  email        String
  accessToken  String
  refreshToken String
  totalSpace   BigInt   @default(0)
  usedSpace    BigInt   @default(0)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  files        DriveFile[]

  @@unique([userId, email])
}

model DriveFile {
  id        String   @id // The actual Google Drive file ID
  accountId String
  name      String
  mimeType  String
  size      BigInt   @default(0)
  parentId  String?  // Google Drive parent folder ID
  thumbnailLink String? // Direct CDN link for fast rendering
  imageTime DateTime? // EXIF Date Taken (for accurate chronological sorting)
  source    String   @default("DRIVE") // 'DRIVE' or 'PHOTOS'
  trashed   Boolean  @default(false)
  updatedAt DateTime @updatedAt // Last modified time from Google Drive

  account   GoogleAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([parentId])
  @@index([name])
}
